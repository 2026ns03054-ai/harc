# copy to cluster.env and edit; read by scripts/experiments.sh
MASTER_IP=10.1.1.4                       # node1: master, client and (for RQ1 n=5,6) local workers
HOSTS=10.1.1.5:2,10.1.1.6:2              # workers for RQ2, RQ3, RQ5: two per 2-vCPU VM
SSH_KEY=~/.ssh/dc-key.pem                # key that logs in to node2 and node3
SSH_USER=azureuser
REPS=5                                   # 10 doubles the time; finished runs are skipped, so you can add reps later
MODEL=models/stories42M.bin
MEAN=60                                  # mean worker session (s)
DOWN=10                                  # downtime after a failure (s)
N=40                                     # requests per run
MIX=256:0.5,512:0.5
RQ1_MODELS="models/stories15M.bin models/stories42M.bin"
RQ1_HOSTS="1=10.1.1.5:1 2=10.1.1.5:1,10.1.1.6:1 3=10.1.1.5:2,10.1.1.6:1 4=10.1.1.5:2,10.1.1.6:2"
